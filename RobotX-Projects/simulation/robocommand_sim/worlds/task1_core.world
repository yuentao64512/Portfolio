        <pose>0 -145 105 0 0.82 1.5708</pose>
      </camera>
    </gui>

    <model name="base_ground">
      <static>true</static>
      <pose>0 0 -2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>330 270 0.12</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>330 270 0.12</size></box></geometry>
          <material><ambient>0.38 0.42 0.36 1</ambient><diffuse>0.45 0.50 0.42 1</diffuse></material>
