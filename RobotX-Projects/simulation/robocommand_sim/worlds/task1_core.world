    <scene>
      <ambient>0.54 0.57 0.60 1</ambient>
      <background>0.68 0.80 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 120 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.96 0.92 0.84 1</diffuse>
      <specular>0.35 0.35 0.32 1</specular>
      <direction>-0.45 0.30 -0.85</direction>
