<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drone_landing_pad">
    <static>true</static>
    <link name="pad">
      <collision name="collision">
        <geometry><box><size>12 12 0.4</size></box></geometry>
      </collision>
      <visual name="surface">
        <geometry><box><size>12 12 0.4</size></box></geometry>
        <material>
          <ambient>0.18 0.20 0.22 1</ambient>
          <diffuse>0.28 0.30 0.32 1</diffuse>
        </material>
      </visual>
      <visual name="landing_mark">
        <pose>0 0 0.21 0 0 0</pose>
        <geometry><cylinder><radius>3.2</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.85 0.08 1</diffuse>
          <emissive>0.15 0.10 0.0 1</emissive>
        </material>
      </visual>
      <visual name="landing_cross_x">
        <pose>0 0 0.23 0 0 0</pose>
        <geometry><box><size>0.35 6.0 0.04</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient></material>
      </visual>
      <visual name="landing_cross_y">
        <pose>0 0 0.23 0 0 0</pose>
        <geometry><box><size>6.0 0.35 0.04</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient></material>
      </visual>
    </link>
  </model>
</sdf>
